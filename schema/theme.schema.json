{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "operating-model-explorer/theme.schema.json",
  "title": "theme",
  "description": "Optional words used for each term, in theme.md at the top of the folder. The frame always uses the engine's neutral theme, and each party's colours and mark come from its brand pack.",
  "x-edgy": "None (presentation only)",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "enum": ["theme"], "description": "Always theme." },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Optional id: lower-case letters and numbers joined by hyphens." },
    "name": { "type": "string", "description": "Optional theme name." },
    "colors": { "type": "object", "description": "Retired in 1.2: ignored, with a warning. Party colours now come from brand packs." },
    "fonts": { "type": "object", "description": "Retired in 1.2: ignored, with a warning. The engine always uses its own fonts." },
    "logo": { "type": "string", "description": "Retired in 1.2: ignored, with a warning. The header shows the party marks from brand packs." },
    "palette": { "type": "array", "description": "Retired in 1.2: ignored, with a warning. Each party's colour comes from its brand pack." },
    "labels": {
      "type": "object",
      "description": "Your words for the engine's terms. Anything left out keeps its default.",
      "properties": {
        "model": { "type": "string", "description": "Default: Model" },
        "models": { "type": "string", "description": "Default: Models" },
        "party": { "type": "string", "description": "Default: Party" },
        "parties": { "type": "string", "description": "Default: Parties" },
        "team": { "type": "string", "description": "Default: Team" },
        "teams": { "type": "string", "description": "Default: Teams" },
        "role": { "type": "string", "description": "Default: Role" },
        "roles": { "type": "string", "description": "Default: Roles" },
        "persona": { "type": "string", "description": "Default: Persona" },
        "personas": { "type": "string", "description": "Default: Personas" },
        "workstream": { "type": "string", "description": "Default: Workstream" },
        "workstreams": { "type": "string", "description": "Default: Workstreams" },
        "process": { "type": "string", "description": "Default: Process" },
        "processes": { "type": "string", "description": "Default: Processes" },
        "step": { "type": "string", "description": "Default: Step" },
        "steps": { "type": "string", "description": "Default: Steps" },
        "structure": { "type": "string", "description": "Default: Structure" },
        "structures": { "type": "string", "description": "Default: Structures" },
        "key_message": { "type": "string", "description": "Default: Key message" },
        "key_messages": { "type": "string", "description": "Default: Key messages" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "examples": [
    { "type": "theme", "labels": { "workstream": "Value stream", "workstreams": "Value streams" } }
  ]
}
